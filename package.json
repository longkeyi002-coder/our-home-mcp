{
  "name": "our-home-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral AI Life Runtime with Earth sensing, wake logic, AI-world continuity and replaceable brain adapters",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "start:http": "npm run build && OUR_HOME_MCP_TRANSPORT=http OUR_HOME_RUN_WORKER=true node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:http": "OUR_HOME_MCP_TRANSPORT=http OUR_HOME_RUN_WORKER=true tsx src/index.ts",
    "worker": "npm run start:http",
    "dev:worker": "npm run dev:http",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.20.6",
    "typescript": "6.0.3"
  }
}
