# stdio is the safest default for a local Hermes process.
OUR_HOME_MCP_TRANSPORT=stdio

# Used only by HTTP mode.
OUR_HOME_MCP_HOST=127.0.0.1
OUR_HOME_MCP_PORT=8787

# Optional. If set, HTTP requests must include Authorization: Bearer <token>.
OUR_HOME_MCP_TOKEN=

# Required to enable the phone observation ingestion endpoints.
OUR_HOME_INGEST_TOKEN=

# Optional. Only needed if a browser-based client calls the HTTP endpoint.
OUR_HOME_MCP_CORS_ORIGIN=

# Optional. Defaults to ./data/our-home.json relative to the process directory.
OUR_HOME_DATA_FILE=./data/our-home.json

# Set to false to start with an empty store instead of demo records.
OUR_HOME_SEED=true

# Integrated Life Loop worker. Keep the same process as the HTTP/MCP runtime so one JsonStore owns writes.
OUR_HOME_RUN_WORKER=false
OUR_HOME_WORKER_INTERVAL_MS=60000
OUR_HOME_OUTBOUND_TIMEOUT_MS=30000

# Standalone Android reverse relay. Run `npm run start:relay` beside the main Runtime.
# cloudflared should proxy the public WSS hostname to http://127.0.0.1:8790.
OUR_HOME_RELAY_HOST=127.0.0.1
OUR_HOME_RELAY_PORT=8790
# Must match the prototype token baked into the Android Companion APK. Never publish this value.
OUR_HOME_RELAY_TUNNEL_TOKEN=
# Separate Bearer token used by Hermes when POSTing MCP JSON-RPC to http://127.0.0.1:8790/mcp.
OUR_HOME_RELAY_MCP_TOKEN=
# Optional but recommended in the current single-phone prototype.
OUR_HOME_RELAY_DEVICE_ID=
OUR_HOME_RELAY_REQUEST_TIMEOUT_MS=30000
OUR_HOME_RELAY_MAX_IN_FLIGHT=32

# Optional delivery target. Without this, candidates stay pending and are retried.
OUR_HOME_NOTIFY_WEBHOOK_URL=
OUR_HOME_NOTIFY_WEBHOOK_TOKEN=

# Preferred Android push transport. Both values are required to select FCM.
# GOOGLE_APPLICATION_CREDENTIALS is a runtime file path; never commit its JSON.
OUR_HOME_FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional Hermes decision adapter.
OUR_HOME_HERMES_API_URL=
OUR_HOME_HERMES_API_KEY=
OUR_HOME_HERMES_CONVERSATION=
OUR_HOME_HERMES_MODEL=

# Optional fallback decision webhook.
OUR_HOME_DECISION_WEBHOOK_URL=
OUR_HOME_DECISION_WEBHOOK_TOKEN=
