# Local MCP transport. stdio is the safest default when the AI/agent runs on the same machine.
OUR_HOME_MCP_TRANSPORT=stdio

# Used only by HTTP mode.
OUR_HOME_MCP_HOST=127.0.0.1
OUR_HOME_MCP_PORT=8787

# Optional. If set, HTTP MCP requests require Authorization: Bearer <token>.
OUR_HOME_MCP_TOKEN=

# Bootstrap secret used for initial phone registration / protected ingest.
# Never commit a real value.
OUR_HOME_INGEST_TOKEN=

# Optional. Only needed if a browser client calls the Runtime directly.
OUR_HOME_MCP_CORS_ORIGIN=

# Prototype persistence. Rebuild roadmap will replace this with a transactional store.
OUR_HOME_DATA_FILE=./data/our-home.json
OUR_HOME_SEED=true

# Independent Runtime worker. Runtime stays alive without requiring a model call every tick.
OUR_HOME_RUN_WORKER=false
OUR_HOME_WORKER_INTERVAL_MS=60000

# Generic BrainAdapter over HTTP. This can point to a self-hosted agent or any compatible service.
OUR_HOME_DECISION_WEBHOOK_URL=
OUR_HOME_DECISION_WEBHOOK_TOKEN=

# Optional current Brain provider: Hermes. Hermes is an adapter, not a Runtime dependency.
OUR_HOME_HERMES_API_URL=
OUR_HOME_HERMES_API_KEY=
OUR_HOME_HERMES_CONVERSATION=our-home-life-runtime
OUR_HOME_HERMES_MODEL=hermes-agent

# Optional delivery webhook. Without a notifier, proactive candidates stay pending.
OUR_HOME_NOTIFY_WEBHOOK_URL=
OUR_HOME_NOTIFY_WEBHOOK_TOKEN=

# Preferred Android push transport when both values are configured.
# GOOGLE_APPLICATION_CREDENTIALS is a runtime file path; never commit its JSON.
OUR_HOME_FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
